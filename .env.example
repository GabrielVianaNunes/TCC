# Banco de dados
POSTGRES_DB=senai_zeiss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Primeiro acesso (ver docs/RUNBOOK.md)
ADMIN_BOOTSTRAP_PASSWORD=

# Backup automatizado (Etapa 8) — ver docs/RUNBOOK.md para detalhes
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 0 3 * * *

# Domínio para HTTPS automático (Caddy) — sem isso, serve em HTTP simples
DOMAIN=localhost
