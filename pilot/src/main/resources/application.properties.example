spring.application.name=pilot

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/senai_zeiss}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:changeme}
spring.datasource.driverClassName=org.postgresql.Driver

server.port=${SERVER_PORT:8090}

spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html
spring.thymeleaf.mode=HTML
spring.thymeleaf.encoding=UTF-8
# true (produção) evita reparsear o template a cada requisição; um dev local
# que queira ver alteração de HTML sem reiniciar pode exportar
# THYMELEAF_CACHE=false antes de subir a aplicação.
spring.thymeleaf.cache=${THYMELEAF_CACHE:true}

# Tamanho máximo do arquivo individual
spring.servlet.multipart.max-file-size=10MB

# Tamanho máximo da requisição (útil se enviar múltiplos arquivos ou campos juntos)
spring.servlet.multipart.max-request-size=10MB

# WARN por padrão — DEBUG aqui registra detalhe de autenticação/autorização
# a cada requisição, inadequado fora de uma sessão de depuração pontual.
logging.level.org.springframework.security=${LOG_LEVEL_SECURITY:WARN}

# Pasta base onde documentos anexados (certificados, laudos) são gravados.
# Local (Windows) usa o caminho já em uso; em Docker/produção (Linux), o
# docker-compose.yml sobrescreve via STORAGE_PDF_PATH para um caminho com
# volume nomeado, para o dado sobreviver a um redeploy do contêiner.
storage.pdf.base-path=${STORAGE_PDF_PATH:C:/PDFs}

spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

spring.jpa.hibernate.ddl-auto=validate

# Backup automatizado (Etapa 8)
backup.pg-dump-path=${BACKUP_PG_DUMP_PATH:pg_dump}
backup.s3.endpoint=${BACKUP_S3_ENDPOINT:}
backup.s3.bucket=${BACKUP_S3_BUCKET:}
backup.s3.access-key=${BACKUP_S3_ACCESS_KEY:}
backup.s3.secret-key=${BACKUP_S3_SECRET_KEY:}
backup.s3.region=${BACKUP_S3_REGION:us-east-1}
backup.retention-days=${BACKUP_RETENTION_DAYS:30}
backup.cron=${BACKUP_CRON:0 0 3 * * *}
